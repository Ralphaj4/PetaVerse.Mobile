// Google Maps iOS API key. Copy this file to `Secrets.xcconfig` (gitignored)
// and paste your real key. It flows into Info.plist's GoogleMapsApiKey via
// the $(GOOGLE_MAPS_API_KEY) build variable, then AppDelegate reads it.
//
// iOS bundle id: com.petaverse.app  (restrict the key to this in GCP)
GOOGLE_MAPS_API_KEY=YOUR_IOS_MAPS_API_KEY_HERE
