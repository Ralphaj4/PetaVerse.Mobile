# Google Maps API keys — copy this file to `secrets.properties` (gitignored)
# and fill in your real key(s). Restrict each key in the Google Cloud Console
# (Android: by package name + SHA-1; iOS: by bundle id).
#
# Android package name: com.petaverse.app
ANDROID_MAPS_API_KEY=YOUR_ANDROID_MAPS_API_KEY_HERE
