# Android release signing — copy this file to `key.properties` (gitignored)
# and fill in your real values. On Codemagic this file is generated from secure
# environment variables during the build (see codemagic.yaml), so you never
# commit it. When the file is absent, the release build falls back to debug keys.
#
# `storeFile` is resolved relative to the android/ root. The Codemagic build
# writes the decoded keystore to android/app/upload-keystore.jks.
storeFile=app/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
